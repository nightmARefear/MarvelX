<?xml version="1.0" encoding="utf-8"?>
<!--
    Backups are disabled (android:allowBackup="false"), but on Android 12+ that doesn't stop
    device-to-device transfers. Credentials (tokens, signing data, the pending OAuth attempt) live in
    encrypted DataStore files whose Tink keyset is wrapped by an Android Keystore key that never
    leaves the device, so they are excluded explicitly: copied over, they could never be decrypted.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="keyset_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="keyset_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
